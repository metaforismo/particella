# Public-data providers are anonymous. Chat requires AI Gateway authentication.
# Overrides must be http/https endpoints, including the search/API path.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
PHOTON_URL=https://photon.komoot.io/api/
OVERPASS_URL=https://overpass-api.de/api/interpreter
OPENTOPODATA_URL=https://api.opentopodata.org/v1/eudem25m

# Set to 1 ONLY for a single Node process with a globally enforced 1 request/s limit.
# Vercel production must use a private geocoder or a proxy enforcing that limit globally.
PARTICELLA_SINGLE_INSTANCE=0
# Production services require OVERPASS_URL pointing to your own/contracted hosting.

# Optional, small versioned snapshot refresh. Existing files are never overwritten.
DPC_VERSION=2025-05
# DPC_CSV_URL=https://.../release.csv
# DPC_CSV_FILE=/absolute/path/release.csv
# SNAPSHOT_RETRIEVED_AT=2026-10-06T00:00:00Z
POPULATION_REFRESH=0
# POPULATION_SNAPSHOT_NAME=it-population-2026-01.json

# Total in-process cache budget in bytes (64 MiB). Entries over 25% are skipped.
PARTICELLA_CACHE_MAX_BYTES=67108864

# Routing demo: 1 request/s, X-Client-Id; use dedicated hosting/shared limiter in production.
VALHALLA_URL=https://valhalla1.openstreetmap.de/isochrone

# Chiedi al terreno — AI SDK 7, Vercel AI Gateway.
PARTICELLA_CHAT_MODEL=anthropic/claude-sonnet-5-5
# Required outside Vercel unless a Vercel OIDC token is available in the runtime context.
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN is supplied by Vercel/OIDC tooling; do not commit or log it.
# Public origin of the site, used in metadata and in documentation examples.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
