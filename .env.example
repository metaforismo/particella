# PRODUCTION VERCEL (Node.js / Fluid Compute, fra1): never commit credentials.
# No secret is required just to start the app. Full production functionality needs
# contracted/self-hosted OSM endpoints, a shared Redis and a PRIVATE Blob store.

# REQUIRED in production: HTTPS canonical origin for metadata.
NEXT_PUBLIC_SITE_URL=https://particella.example

# REQUIRED for textual search: self-hosted/contracted Nominatim-compatible search.
# Forbidden production default: https://nominatim.openstreetmap.org/search
# Nominatim public policy also forbids autocomplete; a limiter is not permission.
# These illustrative hosts must be replaced; do not use embedded keys in URLs.
NOMINATIM_URL=https://geocode.example/search
# OPTIONAL fallback: self-hosted Photon-compatible API; configure to avoid the demo.
PHOTON_URL=https://photon.example/api/

# REQUIRED for OSM land/services layers: own/contracted Overpass interpreter.
# Forbidden production default: https://overpass-api.de/api/interpreter
OVERPASS_URL=https://overpass.example/api/interpreter
# REQUIRED for accessibility: Valhalla-compatible /isochrone, own/contracted service.
# Forbidden production default: https://valhalla1.openstreetmap.de/isochrone
VALHALLA_URL=https://routing.example/isochrone
# Must stay 0 on Vercel: instances are multiple. This is not a policy exemption.
PARTICELLA_SINGLE_INSTANCE=0
# OPTIONAL: elevation provider; public quota still applies, no SLA assumed.
OPENTOPODATA_URL=https://api.opentopodata.org/v1/eudem25m

# RECOMMENDED/required for GLOBAL API quotas across instances: Redis REST (e.g. Upstash).
# Both variables must be set together; HTTPS endpoint, no query/userinfo.
# Redis supports EVAL, INCR, PEXPIRE, PTTL, LPUSH, LTRIM, LRANGE, GET, SET, DEL.
# Without Redis, quotas/status/cache are per instance. Counter outages degrade to
# memory for 30s and emit rate_limit_memory_fallback (not a global hard quota).
PARTICELLA_CACHE_REDIS_REST_URL=
PARTICELLA_CACHE_REDIS_REST_TOKEN=
# OPTIONAL in-process budget; 64 MiB by default, entries over 25% skipped.
PARTICELLA_CACHE_MAX_BYTES=67108864

# RECOMMENDED/required for durable cadastral indices on Vercel:
# token from a PRIVATE Vercel Blob store in an EU region (choose fra1).
# OPTIONAL for starting locally; otherwise uses tmpdir, lost on serverless cold start.
BLOB_READ_WRITE_TOKEN=
# Local/VM only: no persistent filesystem on Vercel. Never point outside own cache.
# PARTICELLA_CADASTRAL_INDEX_DIR=/var/cache/particella/cadastral-index
# OPTIONAL admission limits per instance (not a cross-instance download quota).
PARTICELLA_CADASTRAL_MAX_BUILDS=2
PARTICELLA_CADASTRAL_BUILDS_PER_HOUR=30

# OPTIONAL, disabled when empty. Comma-separated SHA-256 hex digests (64 chars).
# Clients send the original high-entropy key: Authorization: Bearer <key>.
# Never put original keys here, in URLs, source control, public env or logs.
# Rotating/revoking = remove the digest and roll out the updated environment.
PARTICELLA_API_KEYS=
# OPTIONAL separate admin digest (one key). Only enables GET status?probe=1.
# Admin and paid/public keys must be different. No configured key = probe 503.
PARTICELLA_ADMIN_KEY_SHA256=

# OPTIONAL AI assistant; absent credentials return not_configured, other APIs work.
PARTICELLA_CHAT_MODEL=anthropic/claude-sonnet-5-5
# Required for chat outside Vercel if runtime OIDC authentication is unavailable.
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN is supplied by the platform/tooling: do not commit or log it.

# OPTIONAL OFFLINE snapshot maintenance (never a deploy hook / cron).
DPC_VERSION=2025-05
# DPC_CSV_URL=https://official.example/release.csv
# DPC_CSV_FILE=/absolute/path/release.csv
# SNAPSHOT_RETRIEVED_AT=2026-10-06T00:00:00Z
POPULATION_REFRESH=0
# POPULATION_SNAPSHOT_NAME=it-population-2026-01.json
