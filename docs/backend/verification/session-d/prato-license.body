nizzazione ai fini della risoluzione delle problematiche tecniche segnalate nell'ambito dell'attivit\u00e0 di collaudo del materiale informatico consegnato all'amministrazione (incompletezza della metadatazione, incongruenze topologiche, incongruenze con le basi cartografiche, vestizione delle basi cartografiche, riorganizzazione dei livelli del progetto cartografico QGIS, ecc.).", "num_resources": 2, "num_tags": 1, "organization": {"id": "c81f1219-0fd5-40dc-8874-0eb1a19088ae", "name": "comune-di-arezzo", "title": "Comune di Arezzo", "type": "organization", "description": "Arezzo (Arretium in latino, Aritim in etrusco) \u00e8 un comune italiano di circa 100.000 abitanti, capoluogo dell'omonima provincia in Toscana. Conosciuta nel mondo come Citt\u00e0 dell'oro e della Giostra del Saracino.", "image_url": "2017-08-09-083100.556772Arezzo-Stemma.png", "created": "2017-08-09T10:31:00.596135", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "c81f1219-0fd5-40dc-8874-0eb1a19088ae", "private": false, "state": "active", "title": "Piano Operativo (PO) - Adozione", "type": "dataset", "url": "opendata.comune.arezzo.it//datasets/po_ado", "version": "1", "extras": [{"key": "contact_email", "value": "opendata@comune.arezzo.it"}, {"key": "contact_name", "value": "Comune di Arezzo"}, {"key": "guid", "value": "c_a390:po_ado:1"}, {"key": "uri", "value": ""}, {"key": "theme", "value": "[\"GOVE\"]"}, {"key": "harvest_object_id", "value": "7d11359c-acc8-41ef-bf85-b8ec57948162"}, {"key": "harvest_source_id", "value": "d083a0e2-3ece-45b0-8f1e-f84dcdb559a8"}, {"key": "harvest_source_title", "value": "Harvester Comune di Arezzo"}, {"key": "identifier", "value": "c_a390:po_ado:1"}, {"key": "alternate_identifier", "value": "[]"}, {"key": "themes_aggregate", "value": "[{\"theme\": \"GOVE\", \"subthemes\": []}]"}, {"key": "publisher_name", "value": "Comune di Arezzo"}, {"key": "publisher_identifier", "value": "c_a390"}, {"key": "modified", "value": "2022-