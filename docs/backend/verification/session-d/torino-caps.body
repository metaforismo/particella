<Service>
  <Name>WMS</Name>
  <Title>Citta&#39; di Torino - PRG Azzonamento</Title>
  <Abstract>Il servizio permette la consultazione degli azzonamenti PRG del Comune di Torino</Abstract>
  <KeywordList>
      <Keyword>Comune di Torino</Keyword>
      <Keyword>Geoportale</Keyword>
      <Keyword>db topografici</Keyword>
      <Keyword>utilizzo del territorio</Keyword>
      <Keyword>cartografia</Keyword>
      <Keyword>PRG Azzonamento</Keyword>
      <Keyword>InfoMapAccessService</Keyword>
      <Keyword vocabulary="ISO">infoMapAccessService</Keyword>
